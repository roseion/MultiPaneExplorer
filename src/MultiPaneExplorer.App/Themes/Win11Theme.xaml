<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ============================================================
    设计系统 v4 —— macOS / Finder 美术风格（WPF 近似实现）
    特征：灰白半透明工具层（#F5F4F2 暖灰）、极浅描边、macOS 系统蓝选中
    （#C9DDF2 淡蓝底 + #0A60FF 主蓝）、6px 控件圆角、柔和投影、冷灰文字
    规则：组件内禁止裸 hex，一律引用 W11.* 语义画刷（键名沿用避免大范围改动）
    ============================================================
    -->

    <!-- ============ 强调色（macOS 系统蓝） ============ -->
    <Color x:Key="AccentColor">#FF0A60FF</Color>
    <SolidColorBrush x:Key="W11.Accent" Color="#0A60FF"/>
    <SolidColorBrush x:Key="W11.AccentHover" Color="#2F79FF"/>
    <SolidColorBrush x:Key="W11.AccentPressed" Color="#084FD1"/>
    <SolidColorBrush x:Key="W11.AccentTint" Color="#E8F0FE"/>

    <!-- ============ 表面（Finder 暖灰工具层 + 白内容） ============ -->
    <SolidColorBrush x:Key="W11.WindowBackground" Color="#F5F4F2"/>
    <SolidColorBrush x:Key="W11.LayerBackground" Color="#F5F4F2"/>
    <SolidColorBrush x:Key="W11.CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="W11.SubtleBackground" Color="#F0EFED"/>
    <SolidColorBrush x:Key="W11.HoverBackground" Color="#E8E7E4"/>
    <SolidColorBrush x:Key="W11.PressedBackground" Color="#DEDCD8"/>
    <SolidColorBrush x:Key="W11.DisabledBackground" Color="#F2F1EF"/>

    <!-- ============ 选中/悬停（Finder 列表行为：淡蓝底、圆角胶囊） ============ -->
    <SolidColorBrush x:Key="W11.SelectionBackground" Color="#C9DDF2"/>
    <SolidColorBrush x:Key="W11.RowHover" Color="#EFEFEF"/>

    <!-- ============ 线与分隔（极浅） ============ -->
    <SolidColorBrush x:Key="W11.CardBorder" Color="#E8E6E3"/>
    <SolidColorBrush x:Key="W11.ControlBorder" Color="#DCDAD6"/>
    <SolidColorBrush x:Key="W11.ControlBorderHover" Color="#C9C7C3"/>
    <SolidColorBrush x:Key="W11.ControlBorderPressed" Color="#B5B3AF"/>
    <SolidColorBrush x:Key="W11.Divider" Color="#E9E7E4"/>
    <SolidColorBrush x:Key="W11.Splitter" Color="#E9E7E4"/>

    <!-- ============ 文字（冷灰层级） ============ -->
    <SolidColorBrush x:Key="W11.TextPrimary" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="W11.TextSecondary" Color="#6E6E73"/>
    <SolidColorBrush x:Key="W11.TextTertiary" Color="#98989D"/>
    <SolidColorBrush x:Key="W11.TextDisabled" Color="#B8B8BD"/>

    <!-- ============ 功能色 / 深色元素 ============ -->
    <SolidColorBrush x:Key="W11.DangerBrush" Color="#FF3B30"/>
    <SolidColorBrush x:Key="W11.DangerPressed" Color="#D70015"/>
    <SolidColorBrush x:Key="W11.SuccessBrush" Color="#28A745"/>
    <SolidColorBrush x:Key="W11.WarningBrush" Color="#B25000"/>
    <SolidColorBrush x:Key="W11.MenuBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="W11.ScrollBarIdle" Color="#C9C7C3"/>
    <SolidColorBrush x:Key="W11.ScrollBarHover" Color="#A5A3A0"/>
    <SolidColorBrush x:Key="W11.ScrollBarDrag" Color="#807E7B"/>
    <SolidColorBrush x:Key="W11.TooltipBackground" Color="#3A3A3C"/>

    <!-- 列表/树选中色（全局系统键覆盖，让 TreeView 默认模板也跟随） -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C9DDF2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1E1E1E"/>

    <!-- ============ 字体 ============ -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ============ 标准 Button（白底 + 6px 圆角 + 极浅描边） ============ -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource W11.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.SubtleBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.HoverBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorderPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.CardBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作按钮：实心强调底（对话框主决策用） -->
    <Style x:Key="W11.AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource W11.Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.AccentHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.AccentPressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.AccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏图标按钮：无边框，悬停圆角灰胶囊 -->
    <Style x:Key="W11.IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.PressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ToggleButton（选中 = 强调淡蓝底 + 主色字） ============ -->
    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.AccentTint}"/>
                            <Setter Property="Foreground" Value="{StaticResource W11.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TextBox（白底；聚焦 = 强调边） ============ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource W11.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="SelectionBrush" Value="{StaticResource W11.Accent}"/>
        <Setter Property="CaretBrush" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.CardBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ CheckBox（圆角 5 选框，强调色勾选） ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="5"
                                Background="{StaticResource W11.CardBackground}"
                                BorderBrush="{StaticResource W11.ControlBorderHover}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource W11.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ RadioButton（圆形选点） ============ -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="{StaticResource W11.CardBackground}"
                                BorderBrush="{StaticResource W11.ControlBorderHover}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource W11.Accent}"
                                     Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                            <Setter TargetName="Ring" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ToolTip（深色气泡 8px 圆角） ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource W11.TooltipBackground}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,5">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ContextMenu（白底 10px 圆角 + 大柔影，macOS 菜单质感） ============ -->
    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="8" Background="{StaticResource W11.MenuBackground}"
                            BorderBrush="{StaticResource W11.CardBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.18"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ MenuItem（6px 圆角；悬停 = 实心强调蓝 + 白字，macOS 菜单行为） ============ -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <TextBlock x:Name="Gesture" Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource W11.TextTertiary}"
                                       Margin="24,0,0,0" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Right"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="8" Background="{StaticResource W11.MenuBackground}"
                                        BorderBrush="{StaticResource W11.CardBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.18"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="#D8E4FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource W11.Divider}" Margin="10,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ScrollBar（Finder 式：常态极淡细条，悬停/拖动才加粗变深） ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Pill" Width="3" CornerRadius="1.5"
                                                    Background="#D6D4D0"
                                                    HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                                    <Setter TargetName="Pill" Property="Width" Value="8"/>
                                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource W11.ScrollBarHover}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource W11.ScrollBarDrag}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Pill" Height="3" CornerRadius="1.5"
                                                            Background="#D6D4D0"
                                                            VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                                            <Setter TargetName="Pill" Property="Height" Value="8"/>
                                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource W11.ScrollBarHover}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource W11.ScrollBarDrag}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ TreeView（透明底融入内容区） ============ -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ============ ComboBoxItem（悬停灰胶囊、选中淡蓝） ============ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5" Margin="3,1">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.SelectionBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ComboBox（白底 6px 圆角；浮层白底大圆角柔影） ============ -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource W11.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11.ControlBorder}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" SnapsToDevicePixels="True"/>
                        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{StaticResource W11.TextSecondary}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                               Focusable="False">
                            <Border Margin="8" MinWidth="{TemplateBinding ActualWidth}"
                                    Background="{StaticResource W11.MenuBackground}"
                                    BorderBrush="{StaticResource W11.CardBorder}" BorderThickness="1"
                                    CornerRadius="10" Padding="2" MaxHeight="260">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.18"/>
                                </Border.Effect>
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.CardBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
