<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ============================================================
    设计系统 v3 —— Windows 11 原生 Fluent 2（依据本地 skill win11-fluent-design，
    规则源自 microsoft/microsoft-ui-reactor skills/design.md 与 WinUI 3 主题值）
    要点：中性灰 Mica 窗底、白色内容卡浮层、控件 4px/浮层 8px 圆角、
    四态成套的主题画刷、组件内禁止裸 hex
    ============================================================
    -->

    <!-- ============ 强调色（WinUI 3 浅色系统蓝） ============ -->
    <Color x:Key="AccentColor">#FF0067C0</Color>
    <SolidColorBrush x:Key="W11.Accent" Color="#0067C0"/>
    <SolidColorBrush x:Key="W11.AccentHover" Color="#1975C5"/>
    <SolidColorBrush x:Key="W11.AccentPressed" Color="#3183CD"/>
    <SolidColorBrush x:Key="W11.AccentTint" Color="#E8F2FB"/>

    <!-- ============ 表面（Mica 中性灰 + 白卡） ============ -->
    <SolidColorBrush x:Key="W11.WindowBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="W11.LayerBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="W11.CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="W11.SubtleBackground" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="W11.HoverBackground" Color="#E9E9E9"/>
    <SolidColorBrush x:Key="W11.PressedBackground" Color="#DEDEDE"/>
    <SolidColorBrush x:Key="W11.DisabledBackground" Color="#FAFAFA"/>

    <!-- ============ 选中/悬停（资源管理器行为：行悬停淡蓝、选中 #CCE4F7） ============ -->
    <SolidColorBrush x:Key="W11.SelectionBackground" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="W11.RowHover" Color="#E8F2FB"/>

    <!-- ============ 线与分隔 ============ -->
    <SolidColorBrush x:Key="W11.CardBorder" Color="#EDEDED"/>
    <SolidColorBrush x:Key="W11.ControlBorder" Color="#E1E1E1"/>
    <SolidColorBrush x:Key="W11.ControlBorderHover" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="W11.ControlBorderPressed" Color="#C9C9C9"/>
    <SolidColorBrush x:Key="W11.Divider" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="W11.Splitter" Color="#E5E5E5"/>

    <!-- ============ 文字（Fluent 中性四档） ============ -->
    <SolidColorBrush x:Key="W11.TextPrimary" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="W11.TextSecondary" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="W11.TextTertiary" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="W11.TextDisabled" Color="#A3A3A3"/>

    <!-- ============ 功能色 / 深色元素 ============ -->
    <SolidColorBrush x:Key="W11.DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="W11.DangerPressed" Color="#A82A22"/>
    <SolidColorBrush x:Key="W11.SuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="W11.WarningBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="W11.MenuBackground" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="W11.ScrollBarIdle" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="W11.ScrollBarHover" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="W11.ScrollBarDrag" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="W11.TooltipBackground" Color="#262626"/>

    <!-- 列表/树选中色（全局系统键覆盖，让 TreeView 默认模板也跟随） -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A1A1A"/>

    <!-- ============ 字体 ============ -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ============ 标准 Button（WinUI 控件填充/描边四态） ============ -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="#FBFBFB"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F9F9F9"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F1F1"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorderPressed}"/>
                            <Setter Property="Foreground" Value="{StaticResource W11.TextSecondary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#F0F0F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作按钮：实心强调底（对话框主决策用） -->
    <Style x:Key="W11.AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource W11.Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.AccentHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.AccentPressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.AccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏图标按钮：无边框透明底，悬停中性浅灰（WinUI SubtleFill） -->
    <Style x:Key="W11.IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.PressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ToggleButton（开关/预览钮；选中 = 强调淡蓝底 + 主色字） ============ -->
    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.SelectionBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ TextBox（白底；聚焦 = 灰边保持 + 底部 2px 强调线，Win11 招牌式） ============ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource W11.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="SelectionBrush" Value="{StaticResource W11.Accent}"/>
        <Setter Property="CaretBrush" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="FocusUnderline" Height="2" Margin="2,0,2,1" VerticalAlignment="Bottom"
                                Background="{StaticResource W11.Accent}" CornerRadius="1" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusUnderline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#F0F0F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ CheckBox（强调色勾选） ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="{StaticResource W11.CardBackground}"
                                BorderBrush="{StaticResource W11.ControlBorderHover}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource W11.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ RadioButton（圆形选点） ============ -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="{StaticResource W11.CardBackground}"
                                BorderBrush="{StaticResource W11.ControlBorderHover}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource W11.Accent}"
                                     Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                            <Setter TargetName="Ring" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource W11.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ToolTip（深色气泡，浮层 8px 圆角） ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource W11.TooltipBackground}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,5">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ContextMenu（亚克力浅底 + 8px 浮层圆角 + 柔影） ============ -->
    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="6" Background="{StaticResource W11.MenuBackground}"
                            BorderBrush="{StaticResource W11.ControlBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.18"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ MenuItem（4px 圆角悬停；内嵌子菜单 Popup 同样式） ============ -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource W11.TextTertiary}"
                                       Margin="24,0,0,0" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Right"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="6" Background="{StaticResource W11.MenuBackground}"
                                        BorderBrush="{StaticResource W11.ControlBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.18"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.HoverBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource W11.Divider}" Margin="8,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ScrollBar（透明轨道 + 细圆角胶囊贴边，悬停/拖动加粗加深） ============ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Pill" Width="4" CornerRadius="2"
                                                    Background="{StaticResource W11.ScrollBarIdle}"
                                                    HorizontalAlignment="Right" Margin="0,0,1,0"/>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                                    <Setter TargetName="Pill" Property="Width" Value="8"/>
                                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource W11.ScrollBarHover}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource W11.ScrollBarDrag}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Pill" Height="4" CornerRadius="2"
                                                            Background="{StaticResource W11.ScrollBarIdle}"
                                                            VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                                            <Setter TargetName="Pill" Property="Height" Value="8"/>
                                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource W11.ScrollBarHover}"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource W11.ScrollBarDrag}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ TreeView（透明底融入 Mica） ============ -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ============ ComboBoxItem（浮层内条目） ============ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5" Margin="2,1">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.SelectionBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ComboBox（WinUI 控件填充；展开浮层亚克力底柔影） ============ -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
        <Setter Property="Background" Value="#FBFBFB"/>
        <Setter Property="BorderBrush" Value="{StaticResource W11.ControlBorder}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" SnapsToDevicePixels="True"/>
                        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{StaticResource W11.TextSecondary}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                               Focusable="False">
                            <Border Margin="6" MinWidth="{TemplateBinding ActualWidth}"
                                    Background="{StaticResource W11.MenuBackground}"
                                    BorderBrush="{StaticResource W11.ControlBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="2" MaxHeight="260">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.18"/>
                                </Border.Effect>
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F9F9F9"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.CardBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource W11.ControlBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource W11.TextDisabled}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.DisabledBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#F0F0F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
