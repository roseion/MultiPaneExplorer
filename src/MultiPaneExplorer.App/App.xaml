<Application x:Class="MultiPaneExplorer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MultiPaneExplorer.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- token 字典由 ThemeManager 在启动时按会话设置替换（默认浅色） -->
                <ResourceDictionary Source="Themes/Tokens.Light.xaml"/>
                <ResourceDictionary Source="Themes/Win11Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
