<Window x:Class="MultiPaneExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:MultiPaneExplorer.App.Controls"
        Title="多栏资源管理器" Width="1440" Height="820"
        Background="{StaticResource W11.WindowBackground}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 标题栏按钮：W11 扁平风，悬停浅灰；关闭钮悬停红底白字 -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D9D9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C50F1F"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel x:Name="RootPanel">
        <!-- 合并后的标题栏：左侧应用名+空白区拖窗口，中部工具栏，右侧自绘窗口按钮 -->
        <Border DockPanel.Dock="Top" x:Name="CaptionBar" Height="36" Background="#F3F3F3"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                            ToolTip="最小化" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                            ToolTip="最大化" Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Content="&#xE8BB;"
                            ToolTip="关闭" Click="CloseButton_Click"/>
                </StackPanel>
                <TextBlock Text="多栏资源管理器" VerticalAlignment="Center" Margin="10,0,14,0"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource W11.TextSecondary}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="布局：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <RadioButton x:Name="LayoutTwoButton" GroupName="PaneLayout" Content="双栏" Tag="Two" IsChecked="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="左右双栏"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                 Checked="Layout_Checked"/>
                    <RadioButton x:Name="LayoutThreeButton" GroupName="PaneLayout" Content="三栏" Tag="Three"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="三列并列"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                 Checked="Layout_Checked"/>
                    <RadioButton x:Name="LayoutFourGridButton" GroupName="PaneLayout" Content="四栏（田字）" Tag="FourGrid"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="田字格四栏，横竖分隔条均可拖拽"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                 Checked="Layout_Checked"/>
                    <RadioButton x:Name="LayoutFourColumnsButton" GroupName="PaneLayout" Content="四栏（并排）" Tag="FourColumns"
                                 VerticalContentAlignment="Center" Margin="0,0,16,0"
                                 ToolTip="单行四列并排，分隔条均可拖拽"
                                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                 Checked="Layout_Checked"/>
                    <CheckBox x:Name="HiddenFilesToggle" Content="显示隐藏文件"
                              VerticalContentAlignment="Center"
                              ToolTip="切换所有窗格是否显示隐藏文件"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              Checked="HiddenFiles_Changed" Unchecked="HiddenFiles_Changed"/>
                    <Button x:Name="UndoButton" Content="&#xE7A7;" Width="30" Height="24" Margin="16,0,0,0"
                            Padding="0" FontSize="14" FontFamily="Segoe MDL2 Assets" IsEnabled="False"
                            ToolTip="撤销 (Ctrl+Z)"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="UndoButton_Click"/>
                    <Button x:Name="RedoButton" Content="&#xE7A6;" Width="30" Height="24" Margin="4,0,0,0"
                            Padding="0" FontSize="14" FontFamily="Segoe MDL2 Assets" IsEnabled="False"
                            ToolTip="重做 (Ctrl+Y)"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="RedoButton_Click"/>
                    <Button x:Name="FavoritesButton" Content="★ 收藏"
                            Margin="16,0,0,0"
                            ToolTip="收藏夹：点击条目跳转激活窗格"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="FavoritesButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid x:Name="PaneGrid"/>
    </DockPanel>
</Window>
