<Window x:Class="MultiPaneExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MultiPaneExplorer.App.Controls"
        Title="多栏资源管理器" Width="1440" Height="820"
        Background="{StaticResource W11.WindowBackground}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="6,4"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="布局：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <RadioButton x:Name="LayoutTwoButton" GroupName="PaneLayout" Content="双栏" Tag="Two" IsChecked="True"
                             VerticalContentAlignment="Center" Margin="0,0,8,0"
                             ToolTip="左右双栏"
                             Checked="Layout_Checked"/>
                <RadioButton x:Name="LayoutThreeButton" GroupName="PaneLayout" Content="三栏" Tag="Three"
                             VerticalContentAlignment="Center" Margin="0,0,8,0"
                             ToolTip="三列并列"
                             Checked="Layout_Checked"/>
                <RadioButton x:Name="LayoutFourGridButton" GroupName="PaneLayout" Content="四栏（田字）" Tag="FourGrid"
                             VerticalContentAlignment="Center" Margin="0,0,8,0"
                             ToolTip="田字格四栏，横竖分隔条均可拖拽"
                             Checked="Layout_Checked"/>
                <RadioButton x:Name="LayoutFourColumnsButton" GroupName="PaneLayout" Content="四栏（并排）" Tag="FourColumns"
                             VerticalContentAlignment="Center" Margin="0,0,16,0"
                             ToolTip="单行四列并排，分隔条均可拖拽"
                             Checked="Layout_Checked"/>
                <CheckBox x:Name="HiddenFilesToggle" Content="显示隐藏文件"
                          VerticalContentAlignment="Center"
                          ToolTip="切换所有窗格是否显示隐藏文件"
                          Checked="HiddenFiles_Changed" Unchecked="HiddenFiles_Changed"/>
                <Button x:Name="UndoButton" Content="&#xE7A7;" Width="30" Height="24" Margin="16,0,0,0"
                        FontFamily="Segoe MDL2 Assets" IsEnabled="False"
                        ToolTip="撤销 (Ctrl+Z)"
                        Click="UndoButton_Click"/>
                <Button x:Name="RedoButton" Content="&#xE7A6;" Width="30" Height="24" Margin="4,0,0,0"
                        FontFamily="Segoe MDL2 Assets" IsEnabled="False"
                        ToolTip="重做 (Ctrl+Y)"
                        Click="RedoButton_Click"/>
                <Button x:Name="FavoritesButton" Content="★ 收藏"
                        Margin="16,0,0,0"
                        ToolTip="收藏夹：点击条目跳转激活窗格"
                        Click="FavoritesButton_Click"/>
            </StackPanel>
        </Border>
        <Grid x:Name="PaneGrid"/>
    </DockPanel>
</Window>
