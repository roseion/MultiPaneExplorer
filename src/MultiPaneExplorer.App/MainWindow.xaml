<Window x:Class="MultiPaneExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:MultiPaneExplorer.App.Controls"
        Title="多栏资源管理器" Width="1440" Height="820"
        Background="{DynamicResource W11.WindowBackground}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 标题栏按钮：W11 扁平风，悬停浅灰；关闭钮悬停红底白字 -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource W11.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource W11.HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource W11.PressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 贴靠布局弹窗里的分区格（悬停高亮） -->
        <Style x:Key="SnapZoneStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource W11.SubtleBackground}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource W11.AccentTint}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource W11.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource W11.DangerBrush}"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource W11.DangerPressed}"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel x:Name="RootPanel">
        <!-- 合并后的标题栏（40px Mica）：左应用名，中部拖拽区，右区功能图标钮+自绘窗口按钮；
             布局切换/显示隐藏文件/预览收进"查看"菜单，保持标题栏极简（Explorer 式） -->
        <Border DockPanel.Dock="Top" x:Name="CaptionBar" Height="40" Background="{DynamicResource W11.LayerBackground}"
                MouseRightButtonUp="CaptionBar_MouseRightButtonUp">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="UndoButton" Content="&#xE7A7;" Width="32" Height="32" Margin="0,0,2,0"
                            Style="{DynamicResource W11.IconButton}" FontSize="14"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" IsEnabled="False"
                            ToolTip="撤销 (Ctrl+Z)"
                            Click="UndoButton_Click"/>
                    <Button x:Name="RedoButton" Content="&#xE7A6;" Width="32" Height="32" Margin="0,0,8,0"
                            Style="{DynamicResource W11.IconButton}" FontSize="14"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            ToolTip="重做 (Ctrl+Y)"
                            Click="RedoButton_Click"/>
                    <Button x:Name="FavoritesButton" Content="&#xE735;" Width="32" Height="32" Margin="0,0,2,0"
                            Style="{DynamicResource W11.IconButton}" FontSize="14"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            ToolTip="收藏夹：点击条目跳转激活窗格"
                            Click="FavoritesButton_Click"/>
                    <Button x:Name="ViewMenuButton" Width="48" Height="32" Margin="0,0,8,0"
                            Style="{DynamicResource W11.IconButton}"
                            ToolTip="布局、显示隐藏文件与预览窗格"
                            Click="ViewMenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="查看" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontSize="8" Margin="4,1,0,0"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                            ToolTip="最小化" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                            ToolTip="最大化" Click="MaximizeButton_Click"
                            MouseEnter="MaximizeButton_MouseEnter" MouseLeave="MaximizeButton_MouseLeave"/>
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Content="&#xE8BB;"
                            ToolTip="关闭" Click="CloseButton_Click"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="多栏资源管理器" VerticalAlignment="Center" Margin="12,0,14,0"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource W11.TextSecondary}"/>
                <!-- 全局搜索：居中胶囊（回车在最近聚焦窗格递归搜索，Esc 清除） -->
                <Grid>
                    <TextBox x:Name="GlobalSearchBox" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontSize="12" Padding="10,5" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                             ToolTip="搜索（回车在当前窗格递归搜索，Esc 清除）"
                             KeyDown="GlobalSearch_KeyDown"/>
                </Grid>
            </DockPanel>
        </Border>
        <!-- Win11 贴靠布局弹窗：最大化钮悬停 400ms 出现，左右两分 + 四宫格 -->
        <Popup x:Name="SnapPopup" PlacementTarget="{Binding ElementName=MaximizeButton}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="False" Focusable="False" PopupAnimation="Fade"
               MouseLeave="SnapPopup_MouseLeave">
            <Border Background="{DynamicResource W11.MenuBackground}" BorderBrush="{DynamicResource W11.ControlBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="72" Height="44" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SnapZoneStyle}" Tag="Left" MouseLeftButtonDown="SnapZone_Click"/>
                        <Border Grid.Column="1" Style="{StaticResource SnapZoneStyle}" Tag="Right" Margin="2,0,0,0"
                                MouseLeftButtonDown="SnapZone_Click"/>
                    </Grid>
                    <Grid Width="72" Height="44">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SnapZoneStyle}" Tag="LeftTop" MouseLeftButtonDown="SnapZone_Click"/>
                        <Border Grid.Column="1" Style="{StaticResource SnapZoneStyle}" Tag="RightTop" Margin="2,0,0,0"
                                MouseLeftButtonDown="SnapZone_Click"/>
                        <Border Grid.Row="1" Style="{StaticResource SnapZoneStyle}" Tag="LeftBottom" Margin="0,2,0,0"
                                MouseLeftButtonDown="SnapZone_Click"/>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SnapZoneStyle}" Tag="RightBottom"
                                Margin="2,2,0,0" MouseLeftButtonDown="SnapZone_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
        <!-- 全局预览栏（白底）：跟随最近聚焦窗格的选中项（分隔条在其左侧，可拖宽） -->
        <Border x:Name="PreviewBorder" DockPanel.Dock="Right" Width="260" MinWidth="180" MaxWidth="480"
                Background="{DynamicResource W11.CardBackground}"
                BorderBrush="{DynamicResource W11.Divider}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <controls:PreviewPane x:Name="Preview"/>
        </Border>
        <GridSplitter x:Name="PreviewSplitter" DockPanel.Dock="Right" Width="6"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource W11.Splitter}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      ToolTip="拖拽调整预览栏宽度" Visibility="Collapsed"/>
        <Grid x:Name="PaneGrid"/>
    </DockPanel>
</Window>
