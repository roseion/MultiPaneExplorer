<UserControl x:Class="MultiPaneExplorer.App.Controls.ExplorerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MultiPaneExplorer.App.Models"
             PreviewKeyDown="Pane_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <models:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <DataTemplate x:Key="IconTemplate">
            <Image Source="{Binding IconLarge}" Width="20" Height="20" Margin="0,1"/>
        </DataTemplate>
        <DataTemplate x:Key="NameCellTemplate">
            <Grid>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBox x:Name="RenameBox" Margin="0,-1" Padding="1,0" VerticalContentAlignment="Center"
                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                         Text="{Binding Name, Mode=OneWay}"
                         Loaded="RenameBox_Loaded" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LargeIconTemplate">
            <StackPanel Width="100" Margin="6,4" HorizontalAlignment="Center">
                <Image Source="{Binding LargeIcon}" Width="64" Height="64" Stretch="Uniform"
                       HorizontalAlignment="Center" Margin="2"/>
                <Grid HorizontalAlignment="Center" Width="100">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="32"
                               TextAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" ToolTip="{Binding Name}"
                               Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBox x:Name="RenameBox" FontSize="12" Margin="0,-1" Padding="1,0"
                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                             Text="{Binding Name, Mode=OneWay}"
                             Loaded="RenameBox_Loaded" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ListTemplate">
            <StackPanel Orientation="Horizontal" Margin="4,1">
                <Image Source="{Binding IconLarge}" Width="20" Height="20" Margin="0,1,6,1" VerticalAlignment="Center"/>
                <Grid>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBox x:Name="RenameBox" MinWidth="120" Margin="0,-1" Padding="1,0" VerticalContentAlignment="Center"
                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                             Text="{Binding Name, Mode=OneWay}"
                             Loaded="RenameBox_Loaded" KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="LargeIconsPanel">
            <WrapPanel Orientation="Horizontal" ItemWidth="112"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
        <!-- 详细信息视图的默认面板：代码后置切回 Details 时显式恢复（ItemsPanel 置 null 会覆盖主题默认导致空列表） -->
        <ItemsPanelTemplate x:Key="DetailsItemsPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
        <!-- 标签页卡片：激活 = 白底与主体融为一体；未激活 = 浅灰胶囊（白底上可辨） -->
        <Style x:Key="W11.TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.SubtleBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 此电脑页：驱动器宽卡 -->
        <DataTemplate x:Key="DriveCardTemplate">
            <Border Width="320" Margin="8,6" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding IconLarge}" Width="40" Height="40" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="236">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                        <Border Height="6" CornerRadius="3" Background="{StaticResource W11.ControlBorder}" Margin="0,6,0,4">
                            <Border Background="{StaticResource W11.Accent}" CornerRadius="3"
                                    HorizontalAlignment="Left" Width="{Binding DriveBarWidth}"/>
                        </Border>
                        <TextBlock Text="{Binding DriveInfoText}" FontSize="12"
                                   Foreground="{StaticResource W11.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="DriveCardsPanel">
            <WrapPanel Orientation="Horizontal" ItemWidth="336"/>
        </ItemsPanelTemplate>
        <!-- 列头模板（含拖拽 Thumb） -->
        <!-- Win11 风列头：透明底+悬停浅灰，右缘 Thumb 拖拽调宽 -->
        <!-- 列头：无边框（悬停才显胶囊底），去表格感 -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                    Margin="0,2" Padding="6,4">
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource W11.TextSecondary}"/>
                            </Border>
                            <Thumb x:Name="Resizer" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                                   Background="Transparent"
                                   DragStarted="ColumnResizer_DragStarted"
                                   DragDelta="ColumnResizer_DragDelta"
                                   DragCompleted="ColumnResizer_DragCompleted"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.SubtleBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- 命令/地址行（Explorer 式）：导航钮 32px｜面包屑+搜索（弹性）｜视图与动作 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource W11.LayerBackground}" Padding="8,6" MinHeight="48">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton IsChecked="{Binding ShowTree, Mode=TwoWay}" ToolTip="显示/隐藏文件树"
                                  Width="32" Height="32" Margin="0,0,4,0" Padding="0" FontSize="16"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE700;"/>
                    <Button Command="{Binding BackCommand}" ToolTip="后退" Width="32" Height="32"
                            Style="{StaticResource W11.IconButton}" FontSize="16"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE72B;"/>
                    <Button Command="{Binding ForwardCommand}" ToolTip="前进" Width="32" Height="32"
                            Margin="4,0,0,0" Style="{StaticResource W11.IconButton}" FontSize="16"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE72A;"/>
                    <Button Command="{Binding UpCommand}" ToolTip="向上" Width="32" Height="32"
                            Margin="4,0,0,0" Style="{StaticResource W11.IconButton}" FontSize="16"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE74A;"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" MinHeight="30">
                        <Border x:Name="CrumbBar" Background="{StaticResource W11.CardBackground}" CornerRadius="4" Padding="6,0"
                                BorderBrush="{StaticResource W11.ControlBorder}" BorderThickness="1"
                                MouseLeftButtonDown="CrumbBar_MouseLeftButtonDown"
                                ToolTip="点击空白处输入路径；点击各段跳转，▼ 展开子目录">
                            <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center">
                                <StackPanel x:Name="CrumbStrip" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </Border>
                        <TextBox x:Name="AddressBox" Visibility="Collapsed" VerticalContentAlignment="Center"
                                 ToolTip="输入路径后按回车跳转；输入时下拉补全；Esc 返回"
                                 Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="AddressBox_KeyDown"
                                 TextChanged="AddressBox_TextChanged"
                                 PreviewKeyDown="AddressBox_PreviewKeyDown"
                                 LostKeyboardFocus="AddressBox_LostKeyboardFocus"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <!-- 搜索框：放大镜图标 + 占位文字（避免"空白破洞"感） -->
                        <Grid Width="190" MinWidth="150">
                            <TextBox x:Name="FilterBox" VerticalContentAlignment="Center"
                                     ToolTip="过滤当前列表；勾选右侧则在全部子目录中搜索 (Ctrl+F 聚焦，Esc 清除)"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                     KeyDown="FilterBox_KeyDown"
                                     Padding="26,4,6,4"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource W11.TextTertiary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="搜索" FontSize="12"
                                       Foreground="{StaticResource W11.TextTertiary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=FilterBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <CheckBox Content="子目录" IsChecked="{Binding SearchSubdirectories, Mode=TwoWay}"
                                  Margin="8,0,0,0" VerticalContentAlignment="Center"
                                  ToolTip="勾选后在当前目录及全部子目录中搜索"/>
                    </StackPanel>
                </Grid>
                <!-- 右侧动作区：视图 |（组间距）刷新 |（组间距）新建+回收站，组间 12px 制造主次 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ComboBox x:Name="ViewModeBox" Width="88" Height="32"
                              SelectedValue="{Binding ViewMode}" SelectedValuePath="Tag"
                              ToolTip="视图模式">
                        <ComboBoxItem Content="详细信息" Tag="Details"/>
                        <ComboBoxItem Content="大图标" Tag="LargeIcons"/>
                        <ComboBoxItem Content="列表" Tag="List"/>
                    </ComboBox>
                    <Button Command="{Binding RefreshCommand}" ToolTip="刷新 (F5)" Width="32" Height="32"
                            Margin="16,0,0,0" Style="{StaticResource W11.IconButton}" FontSize="16"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE72C;"/>
                    <Button Command="{Binding NewFolderCommand}" ToolTip="新建文件夹" Width="32" Height="32"
                            Margin="16,0,0,0" Style="{StaticResource W11.IconButton}" FontSize="16"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE8F4;"/>
                    <Button Command="{Binding OpenRecycleBinCommand}" ToolTip="打开回收站" Width="32" Height="32"
                            Margin="4,0,0,0" Style="{StaticResource W11.IconButton}" FontSize="16"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE74D;"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 标签条融入白色主体：白底承载标签，激活标签与主体同色无接缝 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource W11.CardBackground}" Padding="4,0,2,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="26" Height="24" Content="&#xE710;" FontSize="10"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Style="{StaticResource W11.IconButton}"
                        ToolTip="新建标签页 (Ctrl+T)"
                        Click="NewTabButton_Click"/>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" Background="Transparent"
                                MouseLeftButtonDown="TabStrip_MouseLeftButtonDown"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource W11.LayerBackground}" Padding="8,2"
                BorderBrush="{StaticResource W11.Divider}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource W11.TextSecondary}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- 主体全白（用户偏好）：文件树与文件列表同处白色背景，仅顶部命令行保留 Mica 灰 -->
        <Grid Background="{StaticResource W11.CardBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="200" MinWidth="120" MaxWidth="520"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Popup x:Name="AddressSuggestPopup"
                   PlacementTarget="{Binding ElementName=AddressBox}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="{StaticResource W11.MenuBackground}" BorderBrush="{StaticResource W11.ControlBorder}" BorderThickness="1"
                        MinWidth="280" MaxHeight="220" SnapsToDevicePixels="True" CornerRadius="8">
                    <ListBox x:Name="SuggestList" BorderThickness="0"
                             DisplayMemberPath="Name"
                             PreviewKeyDown="SuggestList_PreviewKeyDown"
                             PreviewMouseLeftButtonDown="SuggestList_PreviewMouseLeftButtonDown"
                             MouseDoubleClick="SuggestList_MouseDoubleClick"/>
                </Border>
            </Popup>

            <TreeView x:Name="DirTree" Grid.Column="0" Margin="4,2,0,0"
                      ItemsSource="{Binding TreeRoots}"
                      Visibility="{Binding ShowTree, Converter={StaticResource BoolToVis}}"
                      SelectedItemChanged="DirTree_SelectedItemChanged"
                      ContextMenuOpening="DirTree_ContextMenuOpening">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <EventSetter Event="Expanded" Handler="DirTree_ItemExpanded"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <!-- 驱动器用量信息只在"此电脑"页宽卡呈现；树内保持素净（tooltip 保留容量提示） -->
                        <StackPanel Orientation="Horizontal" Margin="0,2"
                                    ToolTip="{Binding UsageTooltip}">
                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,5,1"
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource W11.Splitter}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ToolTip="拖拽调整文件树宽度"/>

            <!-- 白底主体下内容区不再做"浮卡"，仅保留拖拽提示用的描边（默认透明） -->
            <Border x:Name="DropZone" Grid.Column="2" BorderThickness="1" BorderBrush="Transparent"
                    Background="Transparent" Margin="0" Padding="4,2,4,0">
            <ListView x:Name="EntryList"
                      ItemsSource="{Binding Entries}"
                      SelectionMode="Extended"
                      SelectionChanged="EntryList_SelectionChanged"
                      KeyDown="EntryList_KeyDown"
                      AllowDrop="True"
                      DragOver="EntryList_DragOver"
                      DragLeave="EntryList_DragLeave"
                      Drop="EntryList_Drop"
                      PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="EntryList_PreviewMouseMove"
                      MouseLeftButtonUp="EntryList_MouseLeftButtonUp"
                      LostMouseCapture="EntryList_LostMouseCapture"
                      PreviewTextInput="EntryList_PreviewTextInput"
                      GridViewColumnHeader.Click="ColumnHeader_Click"
                      ContextMenuOpening="EntryList_ContextMenuOpening">
                <!-- 视图模式与"此电脑"驱动卡由代码后置 ApplyViewMode 统一切换（本地值/样式触发器优先级纠缠易错） -->
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制"
                                  InputGestureText="Ctrl+C"
                                  Command="{Binding PlacementTarget.DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="剪切"
                                  InputGestureText="Ctrl+X"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.CutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="粘贴"
                                  InputGestureText="Ctrl+V"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="复制文件路径"
                                  InputGestureText="Ctrl+Shift+C"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <!-- 剪贴板组与回收站组之间无需分割线：剪贴板组在回收站视图整组隐藏，
                             此处保留分割线会产生普通视图双线、回收站视图顶部悬空线 -->
                        <MenuItem Header="还原"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.RestoreSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="全部还原"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.RestoreAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="永久删除"
                                  InputGestureText="Del"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="清空回收站"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.EmptyRecycleBinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"/>
                        <MenuItem Header="新建" Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}">
                            <MenuItem Header="文件夹"
                                      Command="{Binding PlacementTarget.DataContext.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="文本文档"
                                      Command="{Binding PlacementTarget.DataContext.NewTextFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </MenuItem>
                        <MenuItem Header="重命名…"
                                  InputGestureText="F2"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="删除到回收站"
                                  InputGestureText="Del"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="永久删除"
                                  InputGestureText="Shift+Del"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.DeletePermanentlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"/>
                        <MenuItem Header="压缩为 ZIP"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.ZipSelectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="解压到当前文件夹"
                                  ToolTip="把选中的 .zip 解压到当前目录（重名自动改名，不覆盖已有文件）"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.ExtractZipHereCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="解压到独立文件夹"
                                  ToolTip="解压到以压缩包命名的新文件夹（可撤销）"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.ExtractZipToFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="发送到桌面快捷方式"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"
                                  Command="{Binding PlacementTarget.DataContext.SendToDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="打开所在文件夹"
                                  ToolTip="跳转到该文件所在的目录（递归搜索结果用）"
                                  Visibility="{Binding DataContext.IsSearchResultsView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"
                                  Click="OpenContainingFolder_Click"/>
                        <Separator Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"/>
                        <MenuItem Header="打开方式…" Click="OpenWith_Click"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"/>
                        <MenuItem Header="属性" Click="Properties_Click"
                                  Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"/>
                        <Separator Visibility="{Binding DataContext.IsRecycleBinView, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBoolToVis}}"/>
                        <MenuItem Header="刷新"
                                  InputGestureText="F5"
                                  Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource W11.TextPrimary}"/>
                        <Setter Property="Padding" Value="4,3"/>
                        <Setter Property="MinHeight" Value="32"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4" SnapsToDevicePixels="True">
                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                              Columns="{TemplateBinding GridView.ColumnCollection}"
                                                              Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.RowHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.SelectionBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
                        <Style.Triggers>
                            <!-- 大图标/列表模式：改用 ContentPresenter 呈现条目模板（GridViewRowPresenter 仅适用详细信息视图） -->
                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListView}}" Value="LargeIcons">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" SnapsToDevicePixels="True">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.RowHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.SelectionBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListView}}" Value="List">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" SnapsToDevicePixels="True">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.RowHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource W11.SelectionBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView x:Name="EntryView">
                        <GridViewColumn x:Name="IconColumn" Header="" Width="26" CellTemplate="{StaticResource IconTemplate}"/>
                        <GridViewColumn x:Name="NameColumn" Header="名称" Width="280" CellTemplate="{StaticResource NameCellTemplate}"/>
                        <GridViewColumn x:Name="ModifiedColumn" Header="修改时间" Width="140" DisplayMemberBinding="{Binding Modified}"/>
                        <GridViewColumn x:Name="CreatedColumn" Header="创建时间" Width="140" DisplayMemberBinding="{Binding Created}"/>
                        <GridViewColumn x:Name="LocationColumn" Header="位置" Width="0" DisplayMemberBinding="{Binding Location}"/>
                        <GridViewColumn x:Name="TypeColumn" Header="类型" Width="90" DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn x:Name="SizeColumn" Header="大小" Width="90" DisplayMemberBinding="{Binding Size}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
