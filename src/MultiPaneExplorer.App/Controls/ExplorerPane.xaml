<UserControl x:Class="MultiPaneExplorer.App.Controls.ExplorerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Pane_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F3F3" Padding="4"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding BackCommand}" ToolTip="后退" Width="30" Height="24"
                        Margin="0,0,4,0" FontFamily="Segoe MDL2 Assets" Content="&#xE72B;"/>
                <Button Command="{Binding ForwardCommand}" ToolTip="前进" Width="30" Height="24"
                        Margin="0,0,4,0" FontFamily="Segoe MDL2 Assets" Content="&#xE72A;"/>
                <Button Command="{Binding UpCommand}" ToolTip="向上" Width="30" Height="24"
                        Margin="0,0,4,0" FontFamily="Segoe MDL2 Assets" Content="&#xE74A;"/>
                <TextBox x:Name="AddressBox" Width="320" VerticalContentAlignment="Center"
                         ToolTip="输入路径后按回车跳转"
                         Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="AddressBox_KeyDown"/>
                <Button Command="{Binding RefreshCommand}" ToolTip="刷新 (F5)" Width="30" Height="24"
                        Margin="4,0,0,0" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="6,2"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <ListView x:Name="EntryList"
                  ItemsSource="{Binding Entries}"
                  SelectionMode="Extended"
                  SelectionChanged="EntryList_SelectionChanged"
                  KeyDown="EntryList_KeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="320" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding Modified}"/>
                    <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding Size}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
