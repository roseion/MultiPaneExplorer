<UserControl x:Class="MultiPaneExplorer.App.Controls.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- 空态：大图标 + 主/副两行文字 -->
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="56"
                       HorizontalAlignment="Center" Foreground="{DynamicResource W11.TextTertiary}"/>
            <TextBlock Text="选择要预览的项目" HorizontalAlignment="Center" Margin="0,12,0,0"
                       FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource W11.TextPrimary}"/>
            <TextBlock Text="支持图片、文本与文件信息" HorizontalAlignment="Center" Margin="0,4,0,0"
                       FontSize="12" Foreground="{DynamicResource W11.TextTertiary}"/>
        </StackPanel>

        <DockPanel x:Name="ContentRoot" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Padding="10,8"
                    BorderBrush="{DynamicResource W11.ControlBorder}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="HeaderIcon" Width="24" Height="24" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="200">
                        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="MetaText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource W11.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Image x:Name="ImageHost" Stretch="Uniform" Margin="8" Visibility="Collapsed"/>
                <TextBox x:Name="TextHost" IsReadOnly="True" Visibility="Collapsed" BorderThickness="0"
                         Background="Transparent" FontFamily="Consolas" FontSize="12"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
                <StackPanel x:Name="DrivePanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="150" Height="150" HorizontalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource W11.ControlBorder}" StrokeThickness="14"/>
                        <Path x:Name="DonutValue" Stroke="{DynamicResource W11.Accent}" StrokeThickness="14"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock x:Name="DonutPercent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource W11.TextPrimary}"/>
                    </Grid>
                    <TextBlock x:Name="DriveNameText" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Foreground="{DynamicResource W11.TextPrimary}"/>
                    <TextBlock x:Name="DriveSpaceText" FontSize="12" HorizontalAlignment="Center"
                               Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource W11.TextSecondary}"/>
                </StackPanel>
                <StackPanel x:Name="InfoPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Image x:Name="InfoIcon" Width="64" Height="64" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InfoText" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="220"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource W11.TextSecondary}"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
